#!/usr/bin/env bash
#MISE description="Build the glibc Linux release binary for the host architecture into dist/"
#
# The conventional primary Linux artefact, and the one most installers expect:
# linked against glibc, with the Swift runtime bundled by --static-swift-stdlib so
# users need no toolchain installed.
#
# "Bundled runtime" is not "no dependencies". The binary still loads, from the host:
# glibc, libstdc++, libgcc_s, and libcurl — FoundationNetworking does its HTTP
# through libcurl, and a static Swift stdlib does not carry curl with it. Nearly
# every distribution installs libcurl, but minimal and distroless images may not;
# `package-linux-musl` has none of these dependencies and covers those hosts.
#
# glibc's symbol versioning sets a floor — the binary will not start on a system
# whose glibc is older than the one it was built against — so this runs in the
# oldest-glibc image that links, RHEL UBI 9 (2.34). See release.yml.
#
# Unlike the musl SDK, this cannot cross-compile: `--static-swift-stdlib` links
# against the host's glibc, so each architecture is built on a native runner.
# `package-linux-musl` covers hosts this artefact cannot serve.
set -euo pipefail

case "$(uname -m)" in
  x86_64) arch="x86_64" ;;
  aarch64 | arm64) arch="aarch64" ;;
  *)
    echo "unsupported architecture: $(uname -m)" >&2
    exit 1
    ;;
esac
triple="$arch-unknown-linux-gnu"

# Only this variant's slice of dist/ is cleared; see the note in `package`. The
# fragment is per-arch because the two slices are built on separate runners and
# their outputs are merged only at publish time.
rm -f "dist/SHA256SUMS.linux-gnu-$arch" "dist/cmagic-$triple.tar.gz"
mkdir -p dist

# -Xswiftc -static-stdlib works around swiftlang/swift-build#1764 on Swift 6.4.0.
# Swift Build, the default backend, applies the static stdlib at link time but
# compiles against the dynamic resource directory, so the object files never
# request CoreFoundation, ICU and friends and the link dies on ~1,650 undefined
# __CF* symbols. Passing -static-stdlib to compile tasks as well is exactly what the
# upstream fix (swiftlang/swift-build#1763) does. It merged to main on 2026-09-22;
# its backports to 6.4.1 and 6.4.2 were still open at the time of writing. Once
# the toolchain carries the fix, the flag is redundant but harmless — drop it then.
#
# The alternative, --build-system native, also links, but that backend is marked
# deprecated; this keeps the build on the supported one.
#
# -Xlinker --strip-debug drops DWARF but keeps the symbol table: the same shape as
# the macOS binary, which has symbols but no embedded debug info, and it keeps
# function names in Swift crash backtraces. For this binary it saves little
# (25.9 → 24.5 MB compressed) — the win is in package-linux-musl — but it keeps the
# two Linux variants treated alike. Stripping everything would save ~2.7 MB more
# and leave backtraces as bare addresses; not worth it for a CLI run in CI.
flags=(-c release --disable-sandbox --product cmagic --static-swift-stdlib -Xswiftc -static-stdlib
  -Xlinker --strip-debug)
swift build "${flags[@]}"
bin="$(swift build "${flags[@]}" --show-bin-path)"
# Diagnostic only, and not every image ships file(1) — never fail the build for it.
command -v file >/dev/null 2>&1 && file "$bin/cmagic" || true
ls -l "$bin/cmagic"

# Fail rather than silently ship debug info again: the whole point of the flag is
# the download size. The check needs readelf (binutils). It always says what it did,
# because a silent skip is indistinguishable from a pass: where readelf is missing it
# emits a GitHub Actions warning, which shows on the run's summary page.
assert_no_debug_info() {
  if ! command -v readelf >/dev/null 2>&1; then
    echo "::warning::debug-info check skipped for $(basename "$1") — readelf not available"
    return 0
  fi
  # Read the headers into a variable first: piping readelf into `grep -q` lets grep
  # exit on the first match, readelf die of SIGPIPE, and pipefail turn a hit into a miss.
  if grep -q '\.debug_info' <<<"$(readelf -S "$1")"; then
    echo "debug info still present in $1 — --strip-debug did not take effect" >&2
    exit 1
  fi
  echo "debug-info check passed: no .debug_info in $1 (readelf)"
}
assert_no_debug_info "$bin/cmagic"

# gzip -n omits the timestamp/name so repeated packaging of the same binary is
# byte-identical, matching how `package` builds its darwin archives.
tar -cf - -C "$bin" cmagic | gzip -n > "dist/cmagic-$triple.tar.gz"
# Hash from inside dist/ so SHA256SUMS lists bare file names. A user verifies in the
# folder the downloads land in, so a `dist/` prefix made every line of
# `sha256sum -c SHA256SUMS` fail — as it did from v0.1.0 to v0.4.1. tee stays outside
# the subshell, so its path is still relative to the project root.
(cd dist && sha256sum "cmagic-$triple.tar.gz") | tee -a "dist/SHA256SUMS.linux-gnu-$arch"

ls -l dist
