#!/usr/bin/env bash
#MISE description="Tag a version and push it, triggering the release CI. Usage: mise run release 0.1.0"
#USAGE arg "<version>" help="Version tag to create and push, e.g. 0.1.0"
set -euo pipefail

git tag "$usage_version"
git push origin "$usage_version"
echo "pushed tag $usage_version — the release workflow will build and attach assets"
